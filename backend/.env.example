# ========================================================
# CHATNCOLLAB Backend Environment Configuration
# ========================================================

# Server Port (auto-assigned by cloud hosts like Render/Railway/Heroku)
PORT=3000
NODE_ENV=production

# Database Connection:
# For production cloud persistence, use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chatncollab?retryWrites=true&w=majority
# USE_MOCK_MONGO=false
#
# For instant zero-setup local/demo running (in-memory MongoDB):
MONGODB_URI=mongodb://127.0.0.1:27017/chatncollab
USE_MOCK_MONGO=true

# JWT Authentication Secret (use a secure random string)
JWT_SECRET=generate_a_secure_random_jwt_secret_key_here_at_least_32_characters

# Redis Token Blacklisting & Session Revocation:
# For production, use Upstash Redis (free tier: https://upstash.com) or cloud Redis:
# REDIS_URL=rediss://default:password@your-endpoint.upstash.io:6379
# USE_MOCK_REDIS=false
#
# For zero-setup in-memory Redis:
USE_MOCK_REDIS=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Google Gemini AI Co-Pilot:
# Get your free API key at: https://aistudio.google.com
GOOGLE_AI_KEY=AIzaSyYourGeminiApiKeyHere
